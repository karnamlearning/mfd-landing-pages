# Advisorkhoj MF calculator + research API
#
# Copy to `.env.local` and fill in the key values. All of these are
# SERVER-ONLY: no NEXT_PUBLIC_ prefix, so they are never bundled into the
# browser. Calculator calls go through /api/calc/<endpoint>; research calls
# go through /api/research/<endpoint>. Both add the key server-side.

# Upstream host. Defaults to the value below if unset.
ADVISORKHOJ_MF_API_BASE=https://mfapi.advisorkhoj.com

# Default `source` attribution for endpoints that do not override it.
ADVISORKHOJ_SOURCE=sudhanshu-Website

# One key per profile. Endpoints are mapped to a profile in
# lib/calc-endpoints.ts and lib/research-endpoints.ts; a request whose
# profile has no key returns 503.
#
#   default -> getLumpsumCalcResult, getEducationPlannerResult,
#              getSIPCalcResultWithChartData, getRetirementAnnualIncrease,
#              getAllSchemeCategories, getMutualFundSipReturnsPeriod, ...
#   website -> getSchemePerformanceReturns, getSIPReturnsForCategoryPeriodAmount,
#              getTopPerformingLumpsumFunds, getAdvSWPReturnCalculatorNew, ...
#   calc    -> getSwpCalcResult, getNPSCalcResultNew, getImpactResult, ...
ADVISORKHOJ_KEY_DEFAULT=
ADVISORKHOJ_KEY_WEBSITE=
ADVISORKHOJ_KEY_CALC=
